# ── Platform Foundation Environment Variables ──────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ── Google Cloud APIs ──────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key

# ── Anthropic (Safety & Classification) ────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Database (ADR-053 D4) — docs/TENANCY_OPERATIONS.md §1 ─────────────
# Request connection: the transaction pooler (port 6543) as app_tenant.<project-ref>, which
# cannot bypass row-level security. Owner connection: the same pooler as postgres.<project-ref>,
# for operator paths only. Different users; no TLS options in the URLs (DATABASE_SSL is the source).
DATABASE_URL=postgresql://app_tenant.your-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_OWNER_URL=postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# verify-full (default; certificate checked) or disable (local and CI only)
DATABASE_SSL=verify-full
# The provider's CA certificate, PEM on one line with \n for each line break (verify-full)
DATABASE_SSL_CA=
# Optional: connections per instance (serverless 1–3) and statement timeout in milliseconds
# DATABASE_POOL_MAX=3
# DATABASE_STATEMENT_TIMEOUT_MS=10000

# Durable stores: postgres in production ("supabase" selects the same store)
MODERATION_STORE=postgres
STRIKE_STORE=postgres
REVIEW_QUEUE_STORE=postgres
SOCIAL_STORE=postgres
APP_STATE_STORE=postgres
TRAJECTORY_STORE=postgres
BUDGET_STORE=postgres
PROPOSAL_STORE=postgres
EFFECT_LEDGER=postgres
APPROVAL_POLICY_STORE=postgres
GUEST_USAGE_STORE=postgres
RATE_LIMIT_STORE=postgres
# Background jobs and their schedules (ADR-056 D2) — needs migration 050
JOB_STORE=postgres
CACHE_PROVIDER=memory

# ── Background jobs (ADR-056 D2) ───────────────────────────────────────
# The job tick's bearer secret: Vercel Cron sends it to /api/internal/jobs/tick (vercel.json);
# on a host without a scheduler, run `npm run jobs:worker` with the same secret and
# JOBS_WORKER_URL. Required in every deployment (boot refuses one without it: no timed duty
# would run); unset locally, every tick is refused. Server-side only;
# at least 32 characters. Generate with: openssl rand -hex 32
CRON_SECRET=
# CLI worker only (scripts/jobs-worker.mjs):
# JOBS_WORKER_URL=http://localhost:3000
# JOBS_WORKER_INTERVAL_SECONDS=60

# ── Host (ADR-055) — docs/DEPLOY_CONTAINER.md ─────────────────────────
# The host's name: vercel, container (baked into the image), aws, … ("local" and "ci" mark runs
# that are not deployments — only they accept the E2E harness switches).
DEPLOYMENT_HOST=vercel
# Container image only — set by the image, not here:
#   GIT_COMMIT_SHA (the build argument; reported as `commit` by /api/health/ready)
#   NEXT_MANUAL_SIG_HANDLE=true (the app handles SIGTERM: drain, flush, close, exit)
# Graceful shutdown (container hosts): seconds answering "not ready" before stopping, and the
# bound on the whole stop — keep it inside the host's grace period (Docker 10 s, ECS 30 s).
# SHUTDOWN_DRAIN_SECONDS=5
# SHUTDOWN_TIMEOUT_SECONDS=9

# ── Tenancy (ADR-053 D1) ───────────────────────────────────────────────
# single: one tenant (TENANT_ID). shared: the tenant comes from the verified identity or the
# address — then set TENANT_DIRECTORY_STORE=postgres, leave TENANT_ID unset, set
# TENANT_HOST_HEADER, and set the Cognito admin credentials below.
TENANCY_MODE=single
TENANT_ID=00000000-0000-4000-8000-000000000001
# TENANT_DIRECTORY_STORE=postgres
# Shared mode only: where the request's address is read (it decides the tenant before sign-in).
#   x-forwarded-host — behind a proxy that always sets X-Forwarded-Host (Vercel)
#   host             — behind one that does not (AWS ALB): X-Forwarded-Host is then ignored, as
#                      it would be whatever the caller sent (next start keeps a caller's header)
# TENANT_HOST_HEADER=x-forwarded-host
# Proxies in front of the app that append to X-Forwarded-For / X-Forwarded-Host (Vercel: 1)
TRUSTED_PROXY_HOPS=1

# ── Supabase Realtime (only with REALTIME_PROVIDER=supabase) ──────────
# Project URL — the single source (ADR-050 D2): https://<ref>.supabase.co, no path, no
# trailing slash. NEXT_PUBLIC_SUPABASE_URL is an alias: leave it unset, or set it equal.
# REALTIME_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# Server-side only; the legacy service_role JWT (eyJ...), not an sb_secret_ key. For Realtime
# only — never for data (ADR-053 D4).
# SUPABASE_SERVICE_ROLE_KEY=

# ── AWS Cognito (Authentication) ──────────────────────────────────────
# Production refuses the mock provider (ADR-050 D1) — set cognito on every deployment.
AUTH_PROVIDER=cognito

# User Pool ID (e.g., us-east-1_AbCdEf123)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-cognito-user-pool-id

# App Client ID (e.g., 1example2client3id4abcdefgh)
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-client-id

# Region (e.g., us-east-1) — optional; defaults to the pool id's region, and must match it
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# Shared tenancy only: an IAM key allowed to set and read custom:tenant_id on the pool
# (docs/TENANCY_OPERATIONS.md §3.3). Paste the values into the host's settings, never a file.
# COGNITO_ADMIN_ACCESS_KEY_ID=
# COGNITO_ADMIN_SECRET_ACCESS_KEY=

# Guest-token signing key (ADR-050 D4) — server-side only; required in production with a
# real auth provider. Generate with: openssl rand -base64 48
GUEST_TOKEN_SECRET=

# ── Logging ────────────────────────────────────────────────────────────
# Options: error (default), warn, info, debug, silent
LOG_LEVEL=error

# ACRCloud — Song Identification (TASK-040)
ACRCLOUD_HOST=identify-us-west-2.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
SONG_ID_PROVIDER=mock
