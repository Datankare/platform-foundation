+/**
+ * platform/action-pipeline/approval-capability.ts — The proof that a write is the execution of an
+ * approved hold (review 9 H1)
+ *
+ * An approved command-bar action (register_agent, set_agent_scope, set_capability_mapping) writes
+ * a config key that is itself under dual control. Before, that write was held a second time and
+ * the hold was reported as success: the approved action said "applied" and nothing changed.
+ *
+ * A boolean ("already approved") would let any caller skip the hold. Instead:
+ *
+ *   1. claimApproval — called by the pipeline in the one step that uses the approval
+ *      (approved -> executed, atomically, ProposalStore.consume) — mints an ApprovalClaim. At most
+ *      one claim exists per approval: a used approval cannot be consumed again.
+ *   2. bindApprovedWrite turns a claim into a capability for ONE config key and ONE value
+ *      (a digest of its canonical JSON), for the requester the hold was made for. A claim binds
+ *      each key once.
+ *   3. redeemApprovedWrite, called by the config writer before it decides to hold, accepts a
+ *      capability only if this module minted it, it is unused, and the key and value are exactly
+ *      the ones it was bound to; it is then spent. Anything else is refused — never held, never
+ *      applied.
+ *
+ * Every object is frozen and registered in a module-private WeakMap, so a structurally equal
+ * object — built from a request body, a stored payload, a spread copy — is not a capability.
+ *
+ * @module platform/action-pipeline
+ */
+
+import { createHash } from "node:crypto";
+import type { ApprovalClaim, ProposalStore } from "@/platform/kernel/types";
+import { canonicalJson } from "@/platform/action-pipeline/canonical-json";
+
+export type { ApprovalClaim };
+
+interface ClaimState {
+  readonly boundKeys: Set<string>;
+}
+
+const CLAIMS = new WeakMap<ApprovalClaim, ClaimState>();
+
+/** A capability to write one config key with one value, as an approved hold's execution. */
+export interface ApprovedWrite {
+  readonly approvalId: string;
+  readonly label: string;
+  readonly key: string;
+  readonly requesterId?: string;
+}
+
+interface WriteState {
+  readonly valueDigest: string;
+  used: boolean;
+}
+
+const WRITES = new WeakMap<ApprovedWrite, WriteState>();
+
+function digest(value: unknown): string {
+  return createHash("sha256")
+    .update(canonicalJson(value) ?? "undefined")
+    .digest("hex");
+}
+
+/**
+ * Use the approval `proposalId` (approved -> executed, atomically) and mint its claim. Undefined
+ * when it was not approved — never approved, or already used — so a second claim cannot exist.
+ */
+export async function claimApproval(
+  store: ProposalStore,
+  proposalId: string
+): Promise<ApprovalClaim | undefined> {
+  const used = await store.consume(proposalId);
+  if (!used) return undefined;
+  const claim: ApprovalClaim = Object.freeze({
+    proposalId: used.proposalId,
+    label: used.label,
+    operationId: used.operationId,
+    ...(used.actor.onBehalfOf ? { requesterId: used.actor.onBehalfOf } : {}),
+  });
+  CLAIMS.set(claim, { boundKeys: new Set() });
+  return claim;
+}
+
+/** Whether `claim` was minted by claimApproval (not merely shaped like one). */
+export function isApprovalClaim(claim: unknown): claim is ApprovalClaim {
+  return (
+    typeof claim === "object" && claim !== null && CLAIMS.has(claim as ApprovalClaim)
+  );
+}
+
+export type BindRefusal =
+  "not_a_claim" | "key_already_bound" | "requester_mismatch" | "key_not_covered";
+
+/**
+ * A capability for writing `key` = `value` as the execution of `claim`'s approved action, by
+ * `actorId` (who must be the requester the hold was made for). `allowedKeys` are the keys the
+ * approved action writes (its owner's table); a key outside it is refused.
+ */
+export function bindApprovedWrite(
+  claim: ApprovalClaim,
+  key: string,
+  value: unknown,
+  actorId: string,
+  allowedKeys: readonly string[]
+): { ok: true; write: ApprovedWrite } | { ok: false; reason: BindRefusal } {
+  const state = CLAIMS.get(claim);
+  if (!state) return { ok: false, reason: "not_a_claim" };
+  if (!allowedKeys.includes(key)) return { ok: false, reason: "key_not_covered" };
+  if (claim.requesterId !== undefined && claim.requesterId !== actorId) {
+    return { ok: false, reason: "requester_mismatch" };
+  }
+  if (state.boundKeys.has(key)) return { ok: false, reason: "key_already_bound" };
+  state.boundKeys.add(key);
+  const write: ApprovedWrite = Object.freeze({
+    approvalId: claim.proposalId,
+    label: claim.label,
+    key,
+    ...(claim.requesterId !== undefined ? { requesterId: claim.requesterId } : {}),
+  });
+  WRITES.set(write, { valueDigest: digest(value), used: false });
+  return { ok: true, write };
+}
+
+export type RedeemRefusal = "forged" | "reused" | "key_mismatch" | "value_mismatch";
+
+/**
+ * Spend `write` for writing `key` = `value`: its approval id when it is genuine, unused and bound
+ * to exactly this key and value; otherwise the refusal. Spent on success only — a mismatch does
+ * not burn it, but it can never authorize anything but its own key and value.
+ */
+export function redeemApprovedWrite(
+  write: unknown,
+  key: string,
+  value: unknown
+): { ok: true; approvalId: string } | { ok: false; reason: RedeemRefusal } {
+  const state =
+    typeof write === "object" && write !== null
+      ? WRITES.get(write as ApprovedWrite)
+      : undefined;
+  if (!state) return { ok: false, reason: "forged" };
+  if (state.used) return { ok: false, reason: "reused" };
+  const w = write as ApprovedWrite;
+  if (w.key !== key) return { ok: false, reason: "key_mismatch" };
+  if (state.valueDigest !== digest(value)) return { ok: false, reason: "value_mismatch" };
+  state.used = true;
+  return { ok: true, approvalId: w.approvalId };
+}
