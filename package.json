{
  "name": "platform-foundation",
  "version": "6.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 jest --coverage",
    "test:core": "PF_TEST_MODULES=none jest -c jest.core.config.cjs",
    "test:db": "bash scripts/test-db.sh",
    "test:db-serial": "jest --testMatch \"<rootDir>/__tests__/db-serial/**/*.serial.ts\" --runInBand",
    "test:mutation": "stryker run",
    "eval:live": "TEST_EVAL_LIVE_ANTHROPIC_KEY=\"$ANTHROPIC_API_KEY\" jest --testMatch \"<rootDir>/prompts/evals/live.run.ts\" --coverage=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sprint:check": "node scripts/sprint-check.mjs",
    "schema:check": "REQUIRE_DB_TESTS=1 jest __tests__/db/sql-schema-parity.db.test.ts",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "overrides:audit": "node scripts/override-audit.mjs",
    "jobs:worker": "node scripts/jobs-worker.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "ajv": "8.20.0",
    "intl-messageformat": "12.1.4",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "safe-regex2": "^5.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "10.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "deepmerge": "file:vendor/deepmerge",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-regexp": "^3.3.1",
    "fast-check": "4.10.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5",
    "yaml": "2.9.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "app/api/**/*.ts",
      "app/admin/**/*.tsx",
      "components/**/*.tsx",
      "platform/**/*.{ts,tsx}",
      "!platform/**/__tests__/**",
      "!platform/**/*.d.ts",
      "!platform/adaptive/index.ts",
      "!platform/admin/index.ts",
      "!platform/agents/index.ts",
      "!platform/ai/index.ts",
      "!platform/content/index.ts",
      "!platform/data/index.ts",
      "!platform/effects/index.ts",
      "!platform/errors/index.ts",
      "!platform/features/index.ts",
      "!platform/gdpr/index.ts",
      "!platform/input/index.ts",
      "!platform/jobs/index.ts",
      "!platform/kernel/index.ts",
      "!platform/moderation/index.ts",
      "!platform/modules/index.ts",
      "!platform/providers/index.ts",
      "!platform/rate-limit/index.ts",
      "!platform/realtime/index.ts",
      "!platform/social/index.ts",
      "!platform/social/agents/index.ts",
      "!platform/translation/index.ts",
      "!platform/voice/index.ts",
      "!platform/auth/index.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "lines": 90,
        "functions": 90,
        "branches": 76
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "components/SpikeApp.tsx",
      "jest.setup.ts"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {}
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(intl-messageformat|@formatjs|jose)/)"
    ]
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.8",
    "@humanfs/node": "^0.16.8",
    "sharp": "^0.35.5",
    "brace-expansion@5": "5.0.12",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "source-map-js": "^1.2.2",
    "qs": "^6.17.1",
    "deepmerge": "$deepmerge",
    "glob": "^14.0.4",
    "@stryker-mutator/core": {
      "minimatch": "^11.0.5"
    },
    "test-exclude": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
