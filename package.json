{
  "name": "platform-foundation",
  "version": "5.1.1",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:core": "PF_TEST_MODULES=none jest -c jest.core.config.cjs",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sprint:check": "node scripts/sprint-check.mjs",
    "schema:check": "REQUIRE_DB_TESTS=1 jest __tests__/db/sql-schema-parity.db.test.ts",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "overrides:audit": "node scripts/override-audit.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "ajv": "8.20.0",
    "intl-messageformat": "12.1.3",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "safe-regex2": "^5.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-regexp": "^3.3.1",
    "fast-check": "4.10.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "app/api/**/*.ts",
      "components/**/*.tsx",
      "platform/auth/**/*.ts",
      "platform/agents/**/*.ts",
      "platform/input/**/*.ts",
      "platform/moderation/**/*.ts",
      "platform/auth/**/*.tsx",
      "platform/admin/**/*.ts",
      "platform/adaptive/**/*.ts",
      "platform/content/**/*.ts",
      "platform/effects/**/*.ts",
      "platform/errors/**/*.ts",
      "platform/features/**/*.ts",
      "platform/social/content/**/*.ts",
      "platform/modules/**/*.ts",
      "!platform/modules/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "lines": 90,
        "functions": 90,
        "branches": 76
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "components/SpikeApp.tsx",
      "components/SpikeAppWrapper.tsx",
      "jest.setup.ts",
      "platform/auth/index.ts",
      "app/admin/page.tsx",
      "components/admin/ActionConfirmPanel.tsx",
      "components/admin/AdminConfigPanels.tsx",
      "components/admin/AdminDataPanels.tsx",
      "components/admin/AdminDataViews.tsx",
      "components/admin/AdminPasswordPanel.tsx",
      "components/admin/AdminPromptBar.tsx",
      "components/admin/ExecutionResultsPanel.tsx"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {}
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(intl-messageformat|@formatjs)/)"
    ]
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.8",
    "@humanfs/node": "^0.16.8",
    "sharp": "^0.35.5",
    "brace-expansion@5": "5.0.12",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "source-map-js": "^1.2.2"
  }
}
